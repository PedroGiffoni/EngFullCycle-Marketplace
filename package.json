{
  "name": "forma-brasileira",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "vite build web --outDir ../dist/web",
    "lint": "eslint src web scripts tests && tsc --noEmit && node scripts/boundaries.mjs",
    "lint:api": "redocly lint docs/openapi.yaml",
    "test": "vitest run",
    "test:unit": "vitest run tests/domain.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:contract": "vitest run tests/contract.test.ts",
    "coverage": "vitest run --coverage",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "verify:seed": "tsx scripts/verify-seed.ts",
    "test:browser": "playwright test",
    "test:ops": "tsx scripts/verify-ops.ts"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-beta.2",
    "@emnapi/runtime": "^2.0.0-beta.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@redocly/cli": "^2.77.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "bullmq": "^6.7.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "motion": "^14.12.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "redis": "^6.3.1",
    "three": "^0.187.0"
  }
}
