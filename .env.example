# Local demonstration only; never reuse in a public environment.
APP_ENV=development
PORT=3000
DATABASE_URL=postgres://forma:forma_local@localhost:55432/forma
# Supabase: session pooler por IPv4; TLS com validação de certificado.
DATABASE_SSL=false
DB_POOL_MAX=20
# Supabase: tabelas preparadas por administrador; API restrita não executa DDL.
RUN_MIGRATIONS=true
# DATABASE_CA_CERT recebe PEM somente quando necessário; nunca desabilitar validação TLS.
REDIS_URL=redis://localhost:6379
CATALOG_CACHE_ENABLED=true
CATALOG_CACHE_TTL=30
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

